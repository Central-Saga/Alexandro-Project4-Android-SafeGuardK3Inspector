<?xml version="1.0" encoding="utf-8"?>
<!--
  Konfigurasi keamanan jaringan SafeGuard K3 Inspector.

  Cleartext (HTTP polos) hanya diizinkan ke host loopback yang memang dipakai
  backend FastAPI saat demo: 127.0.0.1 (ADB reverse) dan 10.0.2.2 (emulator
  AVD). Semua host lain wajib HTTPS, sehingga base URL tidak bisa diam-diam
  ditukar ke server LAN/publik lewat HTTP polos.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
